# ─── Resultados de auditorías — DATOS SENSIBLES, NO PUBLICAR ──────────────────
# Contienen el reconocimiento real de la red (IPs, MACs, puertos, SO, informes).
informes/

# ─── Pie de firma personal — DATOS PERSONALES, NO PUBLICAR ───────────────────
# Nombre, cargo y QR de acreditaciones del analista. Se quedan SOLO en local;
# el informe en GitHub se genera sin firma. (hades_report_docx los carga si existen.)
signature.local.json
assets/qr_credly.png

# ─── Temporales / logs / token de sesión ─────────────────────────────────────
*.log
.scan_token
.hades_token
.ollama_last_metrics.json
hades_run.out
hades_run.err
*.tmp

# ─── WebAuthn — secretos del DISPOSITIVO del usuario, NO PUBLICAR ────────────
# .hades_credentials.json: credentials WebAuthn registradas (clave publica del
#   dispositivo + HMAC). Aunque la clave publica no es secreta criptograficamente,
#   identifica unicamente al equipo del duenio.
# .hades_machine_salt: salt aleatoria que firma el HMAC del archivo de
#   credentials — si se filtra, un atacante podria forjar credentials validas.
.hades_credentials.json
.hades_machine_salt

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─── Sistema operativo ────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# Build temporal del mapa (esbuild)
_mapbuild/
node_modules/
